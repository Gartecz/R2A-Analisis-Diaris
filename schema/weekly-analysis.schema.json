{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gartecz/R2A-Analisis-Diaris/schema/weekly-analysis.schema.json",
  "title": "Informe setmanal R2-A",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "week", "generated_at", "bot", "status", "summary", "coverage", "metrics", "assessment", "alerts", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "bot": { "const": "R2-A" },
    "status": { "enum": ["normal", "watch", "alert", "insufficient_data"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date", "expected_daily_reports", "available_daily_reports"],
      "properties": {
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "expected_daily_reports": { "type": "integer", "minimum": 1, "maximum": 7 },
        "available_daily_reports": { "type": "integer", "minimum": 0, "maximum": 7 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekly_pnl", "closed_operations", "wins", "losses", "win_rate_pct", "worst_floating", "last_balance", "last_equity"],
      "properties": {
        "weekly_pnl": { "type": ["number", "null"] },
        "closed_operations": { "type": ["integer", "null"], "minimum": 0 },
        "wins": { "type": ["integer", "null"], "minimum": 0 },
        "losses": { "type": ["integer", "null"], "minimum": 0 },
        "win_rate_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "worst_floating": { "type": ["number", "null"] },
        "last_balance": { "type": ["number", "null"] },
        "last_equity": { "type": ["number", "null"] }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performance", "risk", "execution", "conclusion"],
      "properties": {
        "performance": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "risk": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "execution": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 1600 }
      }
    },
    "alerts": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "sources": { "type": "array", "minItems": 1, "maxItems": 15, "items": { "type": "string", "format": "uri" } }
  }
}
